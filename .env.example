# Example environment configuration for the Pi Telegram gateway.
# Copy to /etc/pi-telegram/pi-telegram.env (or another protected
# location) and fill in real values. The file must be readable only by
# the service user (chmod 600, owned by the "pi" user).

# --- Telegram ---------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Random secret Telegram sends in the X-Telegram-Bot-Api-Secret-Token
# header of every webhook request. Generate one with:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS URL under which the webhook is reachable. The path
# portion is the path the gateway serves, e.g. "/telegram/webhook".
TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Numeric IDs only: usernames can change at any time.
TELEGRAM_ALLOWED_USER_IDS=

# --- Pi ---------------------------------------------------------------
# Path to the pi binary (default: "pi").
PI_BINARY=/usr/local/bin/pi

# Provider and model, as accepted by pi's --provider/--model options
# (model IDs usually include the provider prefix). Optional: when unset,
# the flags are omitted and Pi uses its own defaults.
PI_PROVIDER=
PI_MODEL=

# Working directory for the Pi agent (where it reads/edits files).
PI_WORKING_DIRECTORY=/home/pi

# Where Pi stores session files.
PI_SESSION_DIRECTORY=/var/lib/pi/sessions

# Any environment variables your provider needs (e.g. its API key) can
# be declared here: the gateway passes its whole environment through to
# the Pi child process unchanged. The gateway itself never reads
# provider credentials.

# --- Gateway behavior (optional, defaults shown) ----------------------
# HTTP listen address. Keep on loopback; Nginx proxies public traffic.
HTTP_LISTEN_ADDRESS=127.0.0.1:8080

# Log level: debug, info, warn, error.
LOG_LEVEL=info

# Where the gateway stores its chat->session metadata.
# Default: <PI_SESSION_DIRECTORY>/pi-telegram-state.json
#STATE_FILE=/var/lib/pi/sessions/pi-telegram-state.json

# Maximum time a prompt run may take before the gateway gives up
# waiting for agent_settled (seconds).
#PI_PROMPT_TIMEOUT_SECONDS=900

# Maximum time a /bash command may take (seconds).
#PI_BASH_TIMEOUT_SECONDS=300

# Maximum time to wait for an RPC command response (seconds).
#PI_COMMAND_TIMEOUT_SECONDS=60
